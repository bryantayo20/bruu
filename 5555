    <script type="text/babel">

        const projects = [
            {
                id: "student-system",
                title: "Student Information System",
                category: "Web",
                description: "A clear, organized interface for browsing student information.",
                detail: "Designed to make student records easy to scan, with an emphasis on readable layouts and a straightforward browsing experience.",
                stack: ["HTML", "CSS", "Bootstrap"]
            },
            {
                id: "temperature-converter",
                title: "Temperature Converter",
                category: "Tools",
                description: "Convert temperatures between Celsius and Fahrenheit.",
                detail: "A small utility that turns a familiar conversion into a responsive, instant interaction with JavaScript.",
                stack: ["HTML", "CSS", "JavaScript"]
            },
            {
                id: "calculator",
                title: "Simple Calculator",
                category: "Tools",
                description: "A beginner-friendly calculator built around quick input.",
                detail: "A practice project for connecting interface controls to JavaScript functions and clear feedback.",
                stack: ["HTML", "CSS", "JavaScript"]
            }
        ];

        function ProjectExplorer() {
            const [query, setQuery] = React.useState("");
            const [category, setCategory] = React.useState("All");
            const [selectedId, setSelectedId] = React.useState(projects[0].id);
            const categories = ["All", "Web", "Tools"];
            const visibleProjects = projects.filter((project) => {
                const matchesCategory = category === "All" || project.category === category;
                const searchableText = `${project.title} ${project.description} ${project.stack.join(" ")}`.toLowerCase();
                return matchesCategory && searchableText.includes(query.toLowerCase().trim());
            });
            const selectedProject = projects.find((project) => project.id === selectedId);

            function chooseRandomProject() {
                const choices = visibleProjects.filter((project) => project.id !== selectedId);
                if (choices.length) {
                    setSelectedId(choices[Math.floor(Math.random() * choices.length)].id);
                }
            }

            return (
                <div className="project-explorer">
                    <div>
                        <div className="project-tools">
                            <input
                                className="project-search"
                                type="search"
                                placeholder="Search projects or technology..."
                                aria-label="Search projects or technology"
                                value={query}
                                onChange={(event) => setQuery(event.target.value)}
                            />
                            <div className="project-filters" aria-label="Filter projects">
                                {categories.map((item) => (
                                    <button
                                        className="project-filter"
                                        type="button"
                                        key={item}
                                        aria-pressed={category === item}
                                        onClick={() => setCategory(item)}
                                    >
                                        {item}
                                    </button>
                                ))}
                            </div>
                        </div>
                        <div className="project-grid" aria-live="polite">
                            {visibleProjects.length ? visibleProjects.map((project, index) => (
                                <button
                                    className="project-tile"
                                    type="button"
                                    key={project.id}
                                    aria-pressed={selectedId === project.id}
                                    onClick={() => setSelectedId(project.id)}
                                >
                                    <span className="project-kind">0{index + 1} / {project.category}</span>
                                    <h3>{project.title}</h3>
                                    <p>{project.description}</p>
                                </button>
                            )) : (
                                <p className="project-empty">No projects match that search. Try another keyword.</p>
                            )}
                        </div>
                    </div>
                    <aside className="project-detail" aria-live="polite">
                        <div className="d-flex justify-content-between align-items-center gap-2">
                            <span className="project-kind">Project notes</span>
                            <button className="project-random" type="button" onClick={chooseRandomProject}>
                                Surprise me
                            </button>
                        </div>
                        {selectedProject ? (
                            <>
                                <h3>{selectedProject.title}</h3>
                                <p>{selectedProject.detail}</p>
                                <div className="project-stack" aria-label="Technologies">
                                    {selectedProject.stack.map((technology) => <span key={technology}>{technology}</span>)}
                                </div>
                            </>
                        ) : (
                            <p>Select a project to explore its details.</p>
                        )}
                    </aside>
                </div>
            );
        }

        ReactDOM.createRoot(document.getElementById("project-react-app")).render(<ProjectExplorer />);

    </script>

