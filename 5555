        }

        .hero h1 {
            font-size: 50px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .hero h1 span {
            color: #60a5fa;
        }

        .hero h3 {
            color: #94a3b8;
            font-weight: normal;
            margin-bottom: 20px;
        }

        .hero p {
            color: #94a3b8;
            line-height: 1.8;
            max-width: 600px;
        }

        .profile-picture {
            width: 280px;
            height: 280px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #1e293b;
            box-shadow: 0 0 35px rgba(96, 165, 250, 0.20);
        }

        .btn-primary {
            background-color: #2563eb;
            border: none;
            padding: 12px 25px;
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
        }

        .btn-outline-light {
            padding: 11px 25px;
        }

        .section {
            padding: 80px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-weight: bold;
        }

        .section-title p {
            color: #64748b;
        }

        .custom-card {
            background-color: #111827;
            border: 1px solid #1e293b;
            border-radius: 12px;
            padding: 30px;
            height: 100%;
            transition: 0.3s;
        }

        .custom-card:hover {
            transform: translateY(-5px);
            border-color: #3b82f6;
        }

        .custom-card h4 {
            color: #60a5fa;
            margin-bottom: 15px;
        }

        .custom-card p {
            color: #94a3b8;
            line-height: 1.7;
        }

        .info-box {
            background-color: #111827;
            border: 1px solid #1e293b;
            border-radius: 12px;
            padding: 30px;
        }

        .info-item {
            display: grid;
            grid-template-columns: 140px 1fr;
            gap: 20px;
            padding: 15px 0;
            border-bottom: 1px solid #1e293b;
        }

        .info-item:last-child {
            border-bottom: none;
        }

        .info-item strong {
            color: #60a5fa;
        }

        .info-item span {
            color: #e2e8f0;
            text-align: left;
            word-break: break-word;
            line-height: 1.6;
        }

        .tech {
            display: inline-block;
            background-color: #1e293b;
            color: #cbd5e1;
            padding: 10px 18px;
            margin: 5px;
            border-radius: 6px;
            border: 1px solid #334155;
            transition: 0.3s;
        }

        .tech:hover {
            border-color: #60a5fa;
            color: #60a5fa;
        }

        .contact-box {
            background-color: #111827;
            border: 1px solid #1e293b;
            border-radius: 12px;
            padding: 45px;
            text-align: center;
        }

        .contact-box p {
            color: #94a3b8;
        }

        .project-explorer {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(250px, 0.8fr);
            gap: 24px;
            align-items: start;
        }

        .project-tools {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .project-search {
            flex: 1 1 210px;
            min-width: 0;
            padding: 11px 14px;
            color: #e2e8f0;
            background: #111827;
            border: 1px solid #334155;
            border-radius: 6px;
        }

        .project-search:focus {
            border-color: #38bdf8;
            outline: 2px solid rgba(56, 189, 248, 0.2);
        }

        .project-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .project-filter {
            padding: 9px 12px;
            color: #cbd5e1;
            background: transparent;
            border: 1px solid #334155;
            border-radius: 6px;
        }

        .project-filter[aria-pressed="true"] {
            color: #07111f;
            background: #38bdf8;
            border-color: #38bdf8;
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 14px;
        }

        .project-tile {
            width: 100%;
            min-height: 190px;
            padding: 20px;
            text-align: left;
            color: #e2e8f0;
            background: #111827;
            border: 1px solid #1e293b;
            border-radius: 8px;
            transition: border-color 0.2s, transform 0.2s;
        }

        .project-tile:hover,
        .project-tile[aria-pressed="true"] {
            border-color: #38bdf8;
            transform: translateY(-3px);
        }

        .project-tile h3 {
            margin: 12px 0 8px;
            color: #f8fafc;
            font-size: 18px;
        }

        .project-tile p,
        .project-detail p {
            color: #94a3b8;
            line-height: 1.7;
        }

        .project-kind {
            color: #38bdf8;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .project-detail {
            position: sticky;
            top: 100px;
            min-height: 250px;
            padding: 24px;
            background: #111827;
            border: 1px solid #1e293b;
            border-top: 3px solid #38bdf8;
            border-radius: 8px;
        }

        .project-detail h3 {
            margin: 12px 0;
            color: #f8fafc;
            font-size: 22px;
        }

        .project-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 18px;
        }

        .project-stack span {
            padding: 5px 9px;
            color: #cbd5e1;
            background: #1e293b;
            border-radius: 4px;
            font-size: 12px;
        }

        .project-random {
            padding: 8px 11px;
            color: #38bdf8;
            background: transparent;
            border: 1px solid #334155;
            border-radius: 6px;
        }

        .project-random:hover {
            border-color: #38bdf8;
        }

        .project-empty {
            grid-column: 1 / -1;
            padding: 24px;
            color: #94a3b8;
            border: 1px dashed #334155;
            border-radius: 8px;
        }

        footer {
            background-color: #0f172a;
            border-top: 1px solid #1e293b;
            color: #64748b;
            padding: 25px;
        }

        @media (max-width: 768px) {

